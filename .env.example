# ──────────────────────────────────────────────────────
# Fraud Detection Platform Environment Configuration
# Copy this file to .env for local deployment
# ──────────────────────────────────────────────────────

# Environment Mode: development, staging, production
FRAUD_ENVIRONMENT=development

# API Server Configuration
FRAUD_API__HOST=0.0.0.0
FRAUD_API__PORT=8000
FRAUD_API__WORKERS=1
FRAUD_API__DEBUG=false

# Security & Authentication
# Comma-separated valid API keys for production mode
FRAUD_API_KEYS=key-prod-001,key-prod-002
FRAUD_API__JWT_SECRET_KEY=change-this-in-production-secret-key-min-32-chars
FRAUD_API__JWT_ALGORITHM=HS256
FRAUD_API__JWT_EXPIRY_MINUTES=60

# Redis Feature Store
FRAUD_FEATURE_STORE__REDIS_HOST=localhost
FRAUD_FEATURE_STORE__REDIS_PORT=6379
FRAUD_FEATURE_STORE__REDIS_DB=0
FRAUD_FEATURE_STORE__REDIS_PASSWORD=

# Kafka Streaming
FRAUD_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
FRAUD_KAFKA__CONSUMER_GROUP=fraud-scoring-group

# MLflow Tracking
FRAUD_MLFLOW__TRACKING_URI=http://localhost:5000
FRAUD_MLFLOW__EXPERIMENT_NAME=fraud-detection-experiments

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=fraud_platform
